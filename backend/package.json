{
  "name": "@media-library/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm --filter frontend build && tsc",
    "start": "node dist/main.js",
    "import-library": "tsx src/import-library.ts",
    "ffmpeg-test": "tsx src/ffmpeg-test.ts",
    "process-video": "tsx src/process-video.ts",
    "backfill-recorded-at": "tsx src/backfill-recorded-at.ts",
    "create-user": "tsx src/create-user.ts",
    "test": "pnpm --filter @media-library/indexer build && pnpm --filter @media-library/search build && tsc --project tsconfig.test.json && node --test dist-test/test/health.test.js dist-test/test/auth.test.js dist-test/test/database-config.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.1.0",
    "@media-library/indexer": "workspace:*",
    "@media-library/search": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.4"
  }
}
